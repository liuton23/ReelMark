generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String?          @unique
  username        String           @unique
  createdAt       DateTime         @default(now())
  passwordHash    String
  displayName     String?
  avatarUrl       String?
  recommendations Recommendation[]
  sessions        Session[]
  watchEntries    WatchEntry[]
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model Content {
  id               String           @id @default(uuid())
  tmdbId           Int              @unique
  type             ContentType
  title            String
  releaseYear      Int?
  posterPath       String?
  genres           String[]
  overview         String?
  runtime          Int?
  showType         Int?
  numberOfSeasons  Int?
  numberOfEpisodes Int?
  episodeRuntime   Int?
  createdAt        DateTime         @default(now())
  recommendations  Recommendation[]
  watchEntries     WatchEntry[]
}

model WatchEntry {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  watchedAt DateTime @default(now())
  rating    Int?
  notes     String?
  season    Int?
  episode   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, season, episode])
}

model Recommendation {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  contentId String?
  title     String
  reason    String
  tmdbId    Int?
  createdAt DateTime @default(now())
  content   Content? @relation(fields: [contentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

enum ContentType {
  MOVIE
  TV_SHOW
}
